# 依赖：不需要入库（安装 = clone + junction；build 时才需要 tsdown）
node_modules/

# 临时实验目录
.tmp-*/
dist/

# 本机私有文件：技能里可能被写出来的运行时配置（口径上落用户目录，这里再兜一层）
*.local.json
*.local.yaml
!*.local.example.*

# Python 工具（skills/sr-config/tools/）跑起来会生成字节码缓存：不入库、也不该进 tgz
__pycache__/
*.pyc

# 分发用的打包产物（skills/skills.rar 之类）：是导出物不是源码，别进库、也别跟着 "skills" 进 tgz
skills/*.rar
skills/*.zip
skills/*.7z
